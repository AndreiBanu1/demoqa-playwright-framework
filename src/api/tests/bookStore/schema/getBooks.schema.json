{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["books"],
  "properties": {
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["isbn", "title", "author"],
        "properties": {
          "isbn": { "type": "string" },
          "title": { "type": "string" },
          "subTitle": { "type": "string" },
          "author": { "type": "string" },
          "publish_date": { "type": "string" },
          "publisher": { "type": "string" },
          "pages": { "type": "integer" },
          "description": { "type": "string" },
          "website": { "type": "string" }
        }
      }
    }
  }
}
