{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /BookStore/v1/Books — 200 response",
  "type": "object",
  "required": ["books"],
  "additionalProperties": false,
  "properties": {
    "books": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://demoqa.com/schemas/book.schema.json" }
    }
  }
}
